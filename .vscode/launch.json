{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pytest: filter by function (-k)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            },
            "module": "pytest",
            "args": ["-k", "${input:pytestExpression}", "--timeout=0"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            },
            "module": "pytest",
            "args": ["${file}", "--timeout=0"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "inputs": [
        {
            "id": "pytestExpression",
            "type": "promptString",
            "description": "pytest -k <expression>, e.g., test_softmax",
            "default": "test_softmax"
        }
    ]
}
